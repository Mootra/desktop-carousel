<Window x:Class="DesktopCarousel.DesktopWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面轮播" Language="zh-CN" Width="816" Height="148"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Background="Transparent"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="ShortcutTile" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="91" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="950" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Face" Width="63" Height="63" Margin="0,2,0,0"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="19"
                                    Background="#55202A38" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="47" Height="47"
                                           RenderOptions.BitmapScalingMode="Linear" />
                                    <TextBlock x:Name="Fallback" Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="26" Foreground="White" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border x:Name="NamePlate" VerticalAlignment="Top" HorizontalAlignment="Center"
                                    Margin="0,70,0,0" Padding="8,2,8,3" CornerRadius="7"
                                    Background="#B9131C29" Visibility="Hidden" MaxWidth="112">
                                <TextBlock Text="{Binding Name}" Foreground="#FFFDFD" FontSize="11.5"
                                           LineHeight="15" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="Tag" Value="Center">
                                <Setter TargetName="Face" Property="Background" Value="#76212B39" />
                                <Setter TargetName="NamePlate" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#B6243245" />
                                <Setter TargetName="Face" Property="BorderBrush" Value="#B6DFEEFF" />
                                <Setter TargetName="NamePlate" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="White" />
                                <Setter TargetName="NamePlate" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#DC32445E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Canvas x:Name="IconArc" ClipToBounds="True" />
        <Border x:Name="Status" HorizontalAlignment="Center" VerticalAlignment="Center"
                Padding="11,5" Background="#B9131C29" CornerRadius="9">
            <TextBlock x:Name="StatusText" Text="正在读取桌面快捷方式…" Foreground="White" FontSize="12" />
        </Border>
    </Grid>
</Window>
